/* Urdu text readability improvements */
.naat-text,
.full-naat-text {
  font-family: Arial, "Noto Naskh Arabic", serif;
  font-size: 18px;
  font-weight: 400;
  letter-spacing: normal;
  line-height: 2;
  overflow-wrap: anywhere;
  word-break: normal;
  white-space: pre-line;
}

.naat-text {
  text-align: center;
}

.full-naat-text {
  text-align: center;
  font-size: clamp(19px, 4.5vw, 25px);
  line-height: 2.2;
}

.naat-card h3,
.full-naat h2 {
  overflow-wrap: anywhere;
  word-break: normal;
  line-height: 1.8;
}

@media (max-width: 480px) {
  .naat-text {
    font-size: 16px;
    line-height: 2.1;
  }

  .full-naat-text {
    font-size: 19px;
    line-height: 2.2;
  }
}

/* Mehfil-e-Naat: accessibility and mobile polish */
button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  cursor: pointer;
}

button:focus-visible,
a:focus-visible,
input:focus-visible {
  outline: 3px solid #f0d58c;
  outline-offset: 3px;
}

button:active {
  transform: scale(0.98);
}

.naat-card,
.full-naat,
.suggestion-box {
  overflow-wrap: anywhere;
}

.naat-card .read-naat-button {
  width: 100%;
  min-height: 46px;
  margin-top: 16px;
  padding: 10px 16px;
  border: 1px solid #d9bd70;
  border-radius: 12px;
  color: #172719;
  background: linear-gradient(135deg, #f5dfa0, #c7a34d);
  font-size: 14px;
  font-weight: 700;
  transition: filter 0.2s ease;
}

.naat-card .read-naat-button:hover {
  filter: brightness(1.08);
}

.heart,
.favorite-filter,
.card-actions button,
.back-button {
  min-height: 44px;
}

.full-naat {
  width: 100%;
  box-sizing: border-box;
}

.full-naat .back-button {
  max-width: 100%;
  color: #f5dda0;
  background: #173b29;
}

@media (max-width: 650px) {
  .site-header {
    flex-wrap: wrap;
  }

  .favorite-filter {
    min-height: 44px;
  }

  .section-heading {
    align-items: flex-start;
  }

  .naat-card .card-actions button {
    min-width: 120px;
  }

  .full-naat {
    margin: 20px auto;
    padding: 22px 15px;
    border-radius: 18px;
  }

  .full-naat h2 {
    font-size: 25px;
  }

  .full-naat-text {
    font-size: 21px;
    line-height: 2.2;
    overflow-wrap: anywhere;
  }

  .full-naat .card-actions button,
  .full-naat .back-button {
    width: 100%;
    min-height: 46px;
  }
}

@media (prefers-reduced-motion: reduce) {
  button:active {
    transform: none;
  }
}

